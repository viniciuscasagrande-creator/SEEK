// SEEK — Plataforma de Gestão Corporativa Integrada
// Esquema de Banco de Dados Unificado (PostgreSQL / Prisma)
// Pacote 1 (Fundação Corporativa) & Pacote 2 (Experiência e Central de Trabalho)
// Suporte nativo a Multiempresa, Multifilial, 13 Perfis RBAC/ABAC, Auditoria, Workflows, Anexos e Notificações

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. SEEK CORE: EMPRESAS, FILIAIS & ESTRUTURA
// ==========================================

model Company {
  id                String         @id @default(uuid())
  code              String         @unique // Ex: SEEK-CORP
  legalName         String         @map("legal_name") // Razão Social
  tradeName         String         @map("trade_name") // Nome Fantasia
  documentNumber    String         @unique @map("document_number") // CNPJ
  stateRegistry     String?        @map("state_registry")
  municipalRegistry String?        @map("municipal_registry")
  isHolding         Boolean        @default(false) @map("is_holding")
  active            Boolean        @default(true)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  branches          Branch[]
  departments       Department[]
  costCenters       CostCenter[]
  users             User[]
  businessPartners  BusinessPartner[]
  approvalRules     ApprovalRule[]
  contracts         Contract[]
  auditLogs         AuditLog[]
  corporateParams   CorporateParameter[]

  @@map("companies")
}

model Branch {
  id              String         @id @default(uuid())
  companyId       String         @map("company_id")
  code            String         // Ex: FIL-01
  name            String         // Ex: Matriz Curitiba, Filial São Paulo
  documentNumber  String         @map("document_number")
  city            String
  state           String
  isHeadquarter   Boolean        @default(false) @map("is_headquarter")
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now()) @map("created_at")

  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departments     Department[]
  bankAccounts    BankAccount[]
  inventoryItems  InventoryItem[]
  assets          Asset[]

  @@unique([companyId, code])
  @@map("branches")
}

model Department {
  id                  String         @id @default(uuid())
  companyId           String         @map("company_id")
  branchId            String?        @map("branch_id")
  code                String         // Ex: FIN, RH, COM, JUR, TI
  name                String         // Ex: Financeiro, Recursos Humanos
  managerId           String?        @map("manager_id")
  budgetLimit         Decimal?       @map("budget_limit") @db.Decimal(14, 2)
  active              Boolean        @default(true)

  company             Company        @relation(fields: [companyId], references: [id])
  branch              Branch?        @relation(fields: [branchId], references: [id])
  employees           Employee[]
  costCenters         CostCenter[]
  serviceDeskTickets  ServiceDeskTicket[]

  @@unique([companyId, code])
  @@map("departments")
}

model CostCenter {
  id               String         @id @default(uuid())
  companyId        String         @map("company_id")
  departmentId     String?        @map("department_id")
  code             String         // Ex: 1.01.002
  name             String         // Ex: Operações de Bilheteria
  active           Boolean        @default(true)

  company          Company        @relation(fields: [companyId], references: [id])
  department       Department?    @relation(fields: [departmentId], references: [id])
  financialRecords FinancialRecord[]

  @@unique([companyId, code])
  @@map("cost_centers")
}

// ==========================================
// 2. SEEK CORE: AUTENTICAÇÃO, OS 13 PERFIS & RBAC
// ==========================================

enum UserRoleLevel {
  ADMIN_GERAL      // 1. Administrador Geral (acesso irrestrito e configurações)
  DIRETORIA        // 2. Diretoria (visão executiva, holding e alçadas C-level)
  GESTOR           // 3. Gestor Departamental (aprovação de equipe e orçamento)
  FINANCEIRO       // 4. Financeiro (contas a pagar/receber, tesouraria, caixa)
  CONTABILIDADE    // 5. Contabilidade (lançamentos, balancetes, DRE contábil)
  FISCAL           // 6. Fiscal (impostos, retenções, documentos fiscais)
  COMERCIAL        // 7. Comercial (CRM, propostas, funil de vendas, metas)
  RH               // 8. RH (admissões, organograma, cargos, avaliações)
  COMPRAS          // 9. Compras (cotações, pedidos, fornecedores)
  JURIDICO         // 10. Jurídico (contratos, processos, procurações)
  TI               // 11. TI (infraestrutura, acessos, Service Desk)
  AUDITORIA        // 12. Auditoria & Compliance (inspeção de logs e conformidade)
  COLABORADOR      // 13. Colaborador (Central de Trabalho, tarefas, chamados, ponto)
}

model User {
  id              String         @id @default(uuid())
  companyId       String         @map("company_id")
  email           String         @unique
  registrationNumber String?     @unique @map("registration_number")
  passwordHash    String         @map("password_hash")
  fullName        String         @map("full_name")
  avatarUrl       String?        @map("avatar_url")
  roleLevel       UserRoleLevel  @default(COLABORADOR) @map("role_level")
  active          Boolean        @default(true)
  lastLoginAt     DateTime?      @map("last_login_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  company         Company        @relation(fields: [companyId], references: [id])
  employee        Employee?      // Vínculo 1:1 com colaborador do RH
  sessions        Session[]
  passwordResets  PasswordReset[]
  notifications   Notification[]
  userFavorites   UserFavorite[]
  approvalRequestsInitiated ApprovalRequest[] @relation("RequestRequester")
  approvalStepsDecided     ApprovalStep[]    @relation("StepDecider")
  auditLogs       AuditLog[]
  assignedTasks   ProjectTask[]  @relation("TaskAssignee")
  ticketsCreated  ServiceDeskTicket[] @relation("TicketCreator")
  ticketsAssigned ServiceDeskTicket[] @relation("TicketAssignee")
  comments        Comment[]

  @@map("users")
}

model Session {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  token        String    @unique
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model PasswordReset {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  token        String    @unique
  expiresAt    DateTime  @map("expires_at")
  used         Boolean   @default(false)
  createdAt    DateTime  @default(now()) @map("created_at")

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

model UserFavorite {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  moduleCode   String    @map("module_code") // Ex: finance, crm, approvals
  title        String
  route        String
  createdAt    DateTime  @default(now()) @map("created_at")

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleCode])
  @@map("user_favorites")
}

model Notification {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  title        String
  message      String
  type         String    // APPROVAL, SLA_ALERT, CONTRACT, SYSTEM
  linkRoute    String?   @map("link_route")
  read         Boolean   @default(false)
  createdAt    DateTime  @default(now()) @map("created_at")

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ==========================================
// 3. MOTOR CENTRAL DE WORKFLOWS & APROVAÇÕES
// ==========================================

enum WorkflowEntityType {
  COMPRA
  PAGAMENTO
  CONTRATO
  FERIAS
  REEMBOLSO
  DESCONTO_COMERCIAL
}

enum ApprovalStatus {
  PENDENTE
  APROVADO
  REJEITADO
  CANCELADO
}

model ApprovalRule {
  id            String             @id @default(uuid())
  companyId     String             @map("company_id")
  entityType    WorkflowEntityType @map("entity_type")
  minAmount     Decimal            @default(0) @map("min_amount") @db.Decimal(14, 2)
  maxAmount     Decimal?           @map("max_amount") @db.Decimal(14, 2)
  requiredLevel UserRoleLevel      @map("required_level")
  description   String
  order         Int                @default(1)
  active        Boolean            @default(true)

  company       Company            @relation(fields: [companyId], references: [id])

  @@map("approval_rules")
}

model ApprovalRequest {
  id              String             @id @default(uuid())
  companyId       String             @map("company_id")
  entityType      WorkflowEntityType @map("entity_type")
  entityId        String?            @map("entity_id")
  requesterId     String             @map("requester_id")
  title           String
  description     String?
  amount          Decimal?           @db.Decimal(14, 2)
  status          ApprovalStatus     @default(PENDENTE)
  currentStep     Int                @default(1) @map("current_step")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  requester       User               @relation("RequestRequester", fields: [requesterId], references: [id])
  steps           ApprovalStep[]
  comments        Comment[]
  attachments     Attachment[]

  @@map("approval_requests")
}

model ApprovalStep {
  id              String             @id @default(uuid())
  requestId       String             @map("request_id")
  stepNumber      Int                @map("step_number")
  deciderId       String?            @map("decider_id")
  requiredLevel   UserRoleLevel      @map("required_level")
  status          ApprovalStatus     @default(PENDENTE)
  decisionDate    DateTime?          @map("decision_date")
  comment         String?

  request         ApprovalRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  decider         User?              @relation("StepDecider", fields: [deciderId], references: [id])

  @@map("approval_steps")
}

// ==========================================
// 4. PARCEIROS DE NEGÓCIOS UNIFICADOS
// ==========================================

enum PartnerType {
  CLIENTE
  FORNECEDOR
  PARCEIRO
  AMBOS
}

model BusinessPartner {
  id              String         @id @default(uuid())
  companyId       String         @map("company_id")
  type            PartnerType    @default(CLIENTE)
  legalName       String         @map("legal_name")
  tradeName       String?        @map("trade_name")
  documentNumber  String         @map("document_number")
  email           String?
  phone           String?
  city            String?
  state           String?
  rating          Int?           @default(5)
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now()) @map("created_at")

  company         Company        @relation(fields: [companyId], references: [id])
  financialRecords FinancialRecord[]
  purchaseOrders  PurchaseOrder[]
  contracts       Contract[]
  crmDeals        CrmDeal[]

  @@unique([companyId, documentNumber])
  @@map("business_partners")
}

// ==========================================
// 5. FINANCEIRO, CONTABILIDADE & FISCAL
// ==========================================

enum TransactionType {
  PAGAR
  RECEBER
}

enum FinancialStatus {
  PREVISTO
  CONFIRMADO
  PAGO
  CANCELADO
  CONCILIADO
}

model FinancialRecord {
  id              String          @id @default(uuid())
  companyId       String          @map("company_id")
  partnerId       String?         @map("partner_id")
  costCenterId    String?         @map("cost_center_id")
  type            TransactionType
  title           String
  documentNumber  String?         @map("document_number")
  category        String
  amount          Decimal         @db.Decimal(14, 2)
  paidAmount      Decimal?        @map("paid_amount") @db.Decimal(14, 2)
  dueDate         DateTime        @map("due_date")
  paymentDate     DateTime?       @map("payment_date")
  status          FinancialStatus @default(PREVISTO)
  paymentMethod   String?         @map("payment_method")
  bankAccountId   String?         @map("bank_account_id")

  partner         BusinessPartner? @relation(fields: [partnerId], references: [id])
  costCenter      CostCenter?     @relation(fields: [costCenterId], references: [id])
  bankAccount     BankAccount?    @relation(fields: [bankAccountId], references: [id])
  attachments     Attachment[]

  @@map("financial_records")
}

model BankAccount {
  id              String         @id @default(uuid())
  branchId        String         @map("branch_id")
  bankName        String         @map("bank_name")
  bankCode        String         @map("bank_code")
  agency          String
  accountNumber   String         @map("account_number")
  currentBalance  Decimal        @default(0) @map("current_balance") @db.Decimal(14, 2)
  active          Boolean        @default(true)

  branch          Branch         @relation(fields: [branchId], references: [id])
  financialRecords FinancialRecord[]

  @@map("bank_accounts")
}

// ==========================================
// 6. RH & DEPARTAMENTO PESSOAL
// ==========================================

enum ContractRegime {
  CLT
  PJ
  ESTAGIO
  APRENDIZ
}

model Employee {
  id                 String         @id @default(uuid())
  userId             String?        @unique @map("user_id")
  departmentId       String         @map("department_id")
  registrationNumber String         @unique @map("registration_number")
  fullName           String         @map("full_name")
  cpf                String         @unique
  birthDate          DateTime?      @map("birth_date")
  admissionDate      DateTime       @map("admission_date")
  jobTitle           String         @map("job_title")
  regime             ContractRegime @default(CLT)
  baseSalary         Decimal        @map("base_salary") @db.Decimal(14, 2)
  vacationBalance    Int            @default(30) @map("vacation_balance")
  active             Boolean        @default(true)

  user               User?          @relation(fields: [userId], references: [id])
  department         Department     @relation(fields: [departmentId], references: [id])
  assignedAssets     Asset[]

  @@map("employees")
}

// ==========================================
// 7. COMPRAS, SUPRIMENTOS & PATRIMÔNIO
// ==========================================

model PurchaseOrder {
  id               String         @id @default(uuid())
  partnerId        String         @map("partner_id")
  code             String         @unique
  title            String
  totalAmount      Decimal        @map("total_amount") @db.Decimal(14, 2)
  status           String
  deliveryDeadline DateTime?      @map("delivery_deadline")
  createdAt        DateTime       @default(now()) @map("created_at")

  supplier         BusinessPartner @relation(fields: [partnerId], references: [id])
  attachments      Attachment[]

  @@map("purchase_orders")
}

model InventoryItem {
  id              String         @id @default(uuid())
  branchId        String         @map("branch_id")
  sku             String         @unique
  name            String
  category        String
  quantity        Int            @default(0)
  minQuantity     Int            @default(5) @map("min_quantity")
  unitCost        Decimal        @map("unit_cost") @db.Decimal(10, 2)

  branch          Branch         @relation(fields: [branchId], references: [id])

  @@map("inventory_items")
}

model Asset {
  id              String         @id @default(uuid())
  branchId        String         @map("branch_id")
  responsibleId   String?        @map("responsible_id")
  tagNumber       String         @unique @map("tag_number")
  description     String
  category        String
  acquisitionDate DateTime       @map("acquisition_date")
  acquisitionCost Decimal        @map("acquisition_cost") @db.Decimal(12, 2)
  currentValue    Decimal        @map("current_value") @db.Decimal(12, 2)
  status          String

  branch          Branch         @relation(fields: [branchId], references: [id])
  responsible     Employee?      @relation(fields: [responsibleId], references: [id])

  @@map("assets")
}

// ==========================================
// 8. CRM & COMERCIAL
// ==========================================

enum DealStage {
  LEAD
  QUALIFICACAO
  OPORTUNIDADE
  PROPOSTA
  NEGOCIACAO
  APROVACAO
  CONTRATO
  CLIENTE
}

model CrmDeal {
  id              String         @id @default(uuid())
  partnerId       String         @map("partner_id")
  title           String
  value           Decimal        @db.Decimal(14, 2)
  stage           DealStage      @default(LEAD)
  probability     Int            @default(20)
  ownerName       String         @map("owner_name")
  expectedClose   DateTime?      @map("expected_close")
  createdAt       DateTime       @default(now()) @map("created_at")

  partner         BusinessPartner @relation(fields: [partnerId], references: [id])

  @@map("crm_deals")
}

// ==========================================
// 9. PROJETOS & OPERAÇÕES
// ==========================================

model Project {
  id              String         @id @default(uuid())
  code            String         @unique
  name            String
  budget          Decimal?       @db.Decimal(14, 2)
  startDate       DateTime       @map("start_date")
  endDate         DateTime?      @map("end_date")
  status          String
  tasks           ProjectTask[]

  @@map("projects")
}

model ProjectTask {
  id              String         @id @default(uuid())
  projectId       String         @map("project_id")
  assigneeId      String?        @map("assignee_id")
  title           String
  priority        String
  status          String
  dueDate         DateTime?      @map("due_date")

  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee        User?          @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@map("project_tasks")
}

// ==========================================
// 10. CONTRATOS, JURÍDICO & SERVICE DESK
// ==========================================

model Contract {
  id              String         @id @default(uuid())
  companyId       String         @map("company_id")
  partnerId       String         @map("partner_id")
  contractNumber  String         @unique @map("contract_number")
  title           String
  totalValue      Decimal        @map("total_value") @db.Decimal(14, 2)
  startDate       DateTime       @map("start_date")
  endDate         DateTime       @map("end_date")
  autoRenew       Boolean        @default(false) @map("auto_renew")
  status          String

  company         Company        @relation(fields: [companyId], references: [id])
  partner         BusinessPartner @relation(fields: [partnerId], references: [id])
  attachments     Attachment[]

  @@map("contracts")
}

model ServiceDeskTicket {
  id              String         @id @default(uuid())
  departmentId    String         @map("department_id")
  creatorId       String         @map("creator_id")
  assigneeId      String?        @map("assignee_id")
  ticketNumber    String         @unique @map("ticket_number")
  title           String
  description     String
  priority        String
  status          String
  slaDeadline     DateTime       @map("sla_deadline")
  createdAt       DateTime       @default(now()) @map("created_at")

  department      Department     @relation(fields: [departmentId], references: [id])
  creator         User           @relation("TicketCreator", fields: [creatorId], references: [id])
  assignee        User?          @relation("TicketAssignee", fields: [assigneeId], references: [id])
  comments        Comment[]
  attachments     Attachment[]

  @@map("service_desk_tickets")
}

// ==========================================
// 11. ANEXOS, COMENTÁRIOS & PARÂMETROS
// ==========================================

model Attachment {
  id              String         @id @default(uuid())
  fileName        String         @map("file_name")
  fileSize        Int            @map("file_size")
  mimeType        String         @map("mime_type")
  storageUrl      String         @map("storage_url")
  createdAt       DateTime       @default(now()) @map("created_at")

  approvalRequestId String?      @map("approval_request_id")
  approvalRequest   ApprovalRequest? @relation(fields: [approvalRequestId], references: [id])

  financialRecordId String?      @map("financial_record_id")
  financialRecord   FinancialRecord? @relation(fields: [financialRecordId], references: [id])

  purchaseOrderId   String?      @map("purchase_order_id")
  purchaseOrder     PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  contractId        String?      @map("contract_id")
  contract          Contract?    @relation(fields: [contractId], references: [id])

  ticketId          String?      @map("ticket_id")
  ticket            ServiceDeskTicket? @relation(fields: [ticketId], references: [id])

  @@map("attachments")
}

model Comment {
  id              String         @id @default(uuid())
  userId          String         @map("user_id")
  content         String
  createdAt       DateTime       @default(now()) @map("created_at")

  approvalRequestId String?      @map("approval_request_id")
  approvalRequest   ApprovalRequest? @relation(fields: [approvalRequestId], references: [id])

  ticketId          String?      @map("ticket_id")
  ticket            ServiceDeskTicket? @relation(fields: [ticketId], references: [id])

  user            User           @relation(fields: [userId], references: [id])

  @@map("comments")
}

model CorporateParameter {
  id              String         @id @default(uuid())
  companyId       String         @map("company_id")
  parameterKey    String         @map("parameter_key") // Ex: DEFAULT_APPROVAL_TIER_L1
  parameterValue  String         @map("parameter_value")
  description     String?
  updatedAt       DateTime       @updatedAt @map("updated_at")

  company         Company        @relation(fields: [companyId], references: [id])

  @@unique([companyId, parameterKey])
  @@map("corporate_parameters")
}

// ==========================================
// 12. TRILHA UNIVERSAL DE AUDITORIA
// ==========================================

model AuditLog {
  id              String         @id @default(uuid())
  companyId       String         @map("company_id")
  userId          String?        @map("user_id")
  action          String         // CREATE, UPDATE, DELETE, APPROVE, REJECT, LOGIN
  module          String
  entity          String
  entityId        String
  ipAddress       String?        @map("ip_address")
  details         String?
  createdAt       DateTime       @default(now()) @map("created_at")

  company         Company        @relation(fields: [companyId], references: [id])
  user            User?          @relation(fields: [userId], references: [id])

  @@index([companyId, module, createdAt])
  @@map("audit_logs")
}
